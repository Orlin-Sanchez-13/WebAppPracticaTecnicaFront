@page
@model PrivacyModel
@{
    ViewData["Title"] = "Registrar nuevo participante";
    var resultStatus = TempData["ResultStatus"] as string;
    var resultMessage = TempData["ResultMessage"] as string;
    var resultData = TempData["ResultData"] as string;
    var resultErrors = TempData["ResultErrors"] as string;
    var resultRaw = TempData["ResultRaw"] as string;
    var headerClass = resultStatus == "success"
        ? "bg-success text-white"
        : resultStatus == "error" ? "bg-danger text-white" : "";
}
<div class="parent">
    <div class="div1 d-flex align-items-center justify-content-end">
        <img src="~/images/weeCompany.PNG" class="img-fluid logo" alt="Logo">
    </div>

    <div class="div2">
        <div class="card formulario-col">
            <div class="card-body">
                <h2 class="card-title mb-3 registro-title">Registro para participantes</h2>
                <form id="registroForm" method="post">
                    <div class="mb-3">
                        <input asp-for="Participante.NombreCompania" class="form-control" placeholder="Nombre de la compañía">
                    </div>

                    <div class="mb-3">
                        <input asp-for="Participante.Cedula" class="form-control" placeholder="Cédula" autocomplete="off">
                    </div>

                    <div class="mb-3">
                        <input asp-for="Participante.NombreContacto" class="form-control" placeholder="Nombre de la persona para contacto">
                    </div>

                    <div class="mb-3">
                        <input asp-for="Participante.Titulo" class="form-control" placeholder="Título">
                    </div>

                    <div class="mb-3">
                        <input asp-for="Participante.Correo" class="form-control" placeholder="Correo">
                    </div>

                    <div class="mb-3">
                        <input asp-for="Participante.Telefono" class="form-control" placeholder="Teléfono" inputmode="numeric" autocomplete="off">
                    </div>

                    <div class="form-check mb-3 registro-check">
                        <input class="form-check-input" type="checkbox" id="aceptaTerminos">
                        <label for="aceptaTerminos">
                            <h6 class="registro-check-text">He leído y acepto el <a href="#"> Aviso de privacidad/Términos y condiciones </a></h6>
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" id="btnRegistrar" class="btn btn-primary btn-lg" disabled>Continuar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header @headerClass">
                <h5 class="modal-title" id="resultModalLabel"> <center> <p id="resultMessage">@resultMessage</p> </center></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="resultData" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.registrarData = {
            resultStatus: "@resultStatus",
            resultData: @Html.Raw(string.IsNullOrWhiteSpace(resultData) ? "null" : resultData),
            resultErrors: @Html.Raw(string.IsNullOrWhiteSpace(resultErrors) ? "null" : resultErrors),
            consultaUrl: "@Url.Page("Consulta")"
        };
    </script>
    <script src="~/js/pages/registrar.js" asp-append-version="true"></script>
}