@page
@model WebAppPractica.Pages.Index1Model
@{
    ViewData["Title"] = "Consulta de registros";
}
<div class="parent">
    <div class="div1">
        <img src="~/images/weeCompany.PNG" class="logo" />
    </div>
    <div class="div2 tablaRegistros">
        <h2 class="mb-3">Registros</h2>
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Fecha registro</th>
                    </tr>
                </thead>
                <tbody id="registrosBody"></tbody>
            </table>
        </div>

        <nav aria-label="Paginación registros" class="mt-3">
            <ul class="pagination justify-content-center mb-0" id="pagination"></ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const pageSize = 10;
            const registros = [
                { id: 1, nombre: "Ana Pérez", correo: "ana.perez@example.com", fecha: "2026-01-01" },
                { id: 2, nombre: "Carlos Ruiz", correo: "carlos.ruiz@example.com", fecha: "2026-01-02" },
                { id: 3, nombre: "María Gómez", correo: "maria.gomez@example.com", fecha: "2026-01-03" },
                { id: 4, nombre: "Luis Fernández", correo: "luis.fernandez@example.com", fecha: "2026-01-04" },
                { id: 5, nombre: "Sofía Morales", correo: "sofia.morales@example.com", fecha: "2026-01-05" },
                { id: 6, nombre: "David López", correo: "david.lopez@example.com", fecha: "2026-01-06" },
                { id: 7, nombre: "Laura Sánchez", correo: "laura.sanchez@example.com", fecha: "2026-01-07" },
                { id: 8, nombre: "Jorge Díaz", correo: "jorge.diaz@example.com", fecha: "2026-01-08" },
                { id: 9, nombre: "Elena Ruiz", correo: "elena.ruiz@example.com", fecha: "2026-01-09" },
                { id: 10, nombre: "Miguel Torres", correo: "miguel.torres@example.com", fecha: "2026-01-10" },
                { id: 11, nombre: "Paula Ortiz", correo: "paula.ortiz@example.com", fecha: "2026-01-11" },
                { id: 12, nombre: "Fernando Villa", correo: "fernando.villa@example.com", fecha: "2026-01-12" },
                { id: 13, nombre: "Isabel Cruz", correo: "isabel.cruz@example.com", fecha: "2026-01-13" },
                { id: 14, nombre: "Raúl Herrera", correo: "raul.herrera@example.com", fecha: "2026-01-14" },
                { id: 15, nombre: "Marta Molina", correo: "marta.molina@example.com", fecha: "2026-01-15" },
                { id: 16, nombre: "Pablo Bravo", correo: "pablo.bravo@example.com", fecha: "2026-01-16" },
                { id: 17, nombre: "Nuria Vega", correo: "nuria.vega@example.com", fecha: "2026-01-17" },
                { id: 18, nombre: "Andrés Gil", correo: "andres.gil@example.com", fecha: "2026-01-18" },
                { id: 19, nombre: "Carmen Ríos", correo: "carmen.rios@example.com", fecha: "2026-01-19" },
                { id: 20, nombre: "Óscar Medina", correo: "oscar.medina@example.com", fecha: "2026-01-20" },
                { id: 21, nombre: "Verónica Paz", correo: "veronica.paz@example.com", fecha: "2026-01-21" },
                { id: 22, nombre: "Rubén Sáez", correo: "ruben.saez@example.com", fecha: "2026-01-22" },
                { id: 23, nombre: "Inés Blanco", correo: "ines.blanco@example.com", fecha: "2026-01-23" }
            ];

            const registrosBody = document.getElementById('registrosBody');
            const pagination = document.getElementById('pagination');

            function renderPage(page) {
                registrosBody.innerHTML = '';
                const start = (page - 1) * pageSize;
                const pageItems = registros.slice(start, start + pageSize);
                for (const r of pageItems) {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `<th scope="row">${r.id}</th><td>${r.nombre}</td><td>${r.correo}</td><td>${r.fecha}</td>`;
                    registrosBody.appendChild(tr);
                }
                renderPagination(page);
            }

            function renderPagination(activePage) {
                pagination.innerHTML = '';
                const totalPages = Math.ceil(registros.length / pageSize);

                const createPageItem = (page, label, disabled = false, active = false) => {
                    const li = document.createElement('li');
                    li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                    const a = document.createElement('a');
                    a.className = 'page-link';
                    a.href = '#';
                    a.textContent = label;
                    a.addEventListener('click', (e) => {
                        e.preventDefault();
                        if (!disabled && page !== activePage) renderPage(page);
                    });
                    li.appendChild(a);
                    return li;
                };

                pagination.appendChild(createPageItem(Math.max(1, activePage - 1), 'Anterior', activePage === 1));
                for (let p = 1; p <= totalPages; p++) {
                    pagination.appendChild(createPageItem(p, p, false, p === activePage));
                }
                pagination.appendChild(createPageItem(Math.min(totalPages, activePage + 1), 'Siguiente', activePage === totalPages));
            }

            renderPage(1);
        })();
    </script>
}