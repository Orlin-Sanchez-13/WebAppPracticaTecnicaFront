@page
@model WebAppPractica.Pages.Index1Model
@{
    ViewData["Title"] = "Consulta de registros";
}
<div class="parent parent-consulta">
    <div class="div1">
        <img src="~/images/weeCompany.PNG" class="logo" alt="Logo" />
    </div>
    <div class="div2 tablaRegistros">
        <h2 class="mb-3 registro-title2">Registros</h2>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th scope="col">Compañía</th>
                        <th scope="col">Cédula</th>
                        <th scope="col">Contacto</th>
                        <th scope="col">Título</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Teléfono</th>
                    </tr>
                </thead>
                <tbody id="registrosBody"></tbody>
            </table>
        </div>

        <nav aria-label="Paginación registros" class="mt-3">
            <ul id="pagination" class="pagination mb-0"></ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        window.participantesData = @Html.Raw(Model.ParticipantesJson);
    </script>
    <script type="module" src="~/js/pages/consulta.js" asp-append-version="true"></script>
}